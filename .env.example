# ============================================
# PIVOT — variables de entorno (ejemplo)
# ============================================
# Copia este archivo a `.env` y rellena solo lo que necesites.
# NUNCA subas `.env` al repositorio.

# --- Deriv (solo lectura para datos; PIVOT no ejecuta órdenes) ---
# App ID público de Deriv. No es un secreto, pero se deja como placeholder.
DERIV_APP_ID=
# Token de API. Si solo se consumen velas públicas puede quedar vacío.
# Si se rellena, usar una cuenta demo y permisos mínimos (`read`).
DERIV_API_TOKEN=
DERIV_SYMBOL=frxEURUSD
DERIV_TIMEFRAMES=M15,H1,H4,D1
DERIV_ACCOUNT_TYPE=demo
DERIV_ACCOUNT_ID=

# --- Persistencia ---
# En Docker: sqlite:////app/data/pivot.db
# En local:  sqlite:///./data/pivot.db
DATABASE_URL=sqlite:///./data/pivot.db
LOG_LEVEL=INFO

# --- Alertas ---
# 0 = shadow (default). No enviar alertas live salvo operación real consciente.
PIVOT_ALERTAS_LIVE=0
PIVOT_MONITOR_URL=http://127.0.0.1:8080
NTFY_USER=
NTFY_PASS=

# --- Colector IQ Option OTC (solo lectura) ---
# Activos 76 = EURUSD-OTC, 1857 = XAUUSD-OTC (según configuración del colector).
IQ_PUBLIC_ACTIVE_IDS=76,1857
IQ_PUBLIC_DB=./pivotradar_data/iq_public/iq_public.db
IQ_PUBLIC_ENGINE_DATA_DIR=./pivotradar_data
IQ_PUBLIC_INTERVAL=1.0
IQ_PUBLIC_STALE_AFTER=60
IQ_PUBLIC_KEEP_TICKS_DAYS=14
IQ_PUBLIC_NTFY_TOPIC=
IQ_PUBLIC_NTFY_SERVER=https://ntfy.sh
IQ_PUBLIC_NTFY_USER=
IQ_PUBLIC_NTFY_PASS=
IQ_PUBLIC_LOG_LEVEL=INFO
